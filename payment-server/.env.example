# ============================================
# НАСТРОЙКИ СЕРВЕРА
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# GOOGLE SHEETS API
# ============================================
# ID вашей Google таблицы (из URL)
# https://docs.google.com/spreadsheets/d/[ВАШ_ID]/edit
GOOGLE_SPREADSHEET_ID=1xrEdEvfmxNlP-86PJJVn8QqeOXQbCvusguA_SHipwvI

# Название листа в таблице
GOOGLE_SHEET_NAME=Лист1

# Путь к файлу credentials.json для Service Account
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ============================================
# CODEEPAY API
# ============================================
# API ключ из панели управления CodeePay
CODEEPAY_API_KEY=0b5ef975-08e9-4d47-ae75-c0a4197ef498

# URL API CodeePay (обычно не требуется изменять)
CODEEPAY_API_URL=https://api.codeepay.com

# ============================================
# URLS
# ============================================
# URL вашего backend сервера (для webhook от CodeePay)
# ВАЖНО: Должен быть публично доступен с domain ucnominal.ru
BACKEND_URL=https://ucnominal.ru

# URL страницы успеха на Tilda
FRONTEND_SUCCESS_URL=https://apml.online/groupa-reg-squad-masters-success-21nov

# ============================================
# TELEGRAM УВЕДОМЛЕНИЯ (ОПЦИОНАЛЬНО)
# ============================================
# Токен бота для уведомлений об оплате
TELEGRAM_BOT_TOKEN=

# Chat ID для отправки уведомлений
TELEGRAM_CHAT_ID=

# ============================================
# ИНСТРУКЦИИ ПО ЗАПОЛНЕНИЮ
# ============================================
#
# 1. Скопируйте этот файл в .env:
#    cp .env.example .env
#
# 2. Заполните все переменные реальными значениями
#
# 3. Убедитесь, что файл .env добавлен в .gitignore
#    (не публикуйте секретные ключи в Git!)
#
# 4. CodeePay API Key предоставлен в задании:
#    API Key: 0b5ef975-08e9-4d47-ae75-c0a4197ef498
#    Webhook domain: ucnominal.ru
#    Webhook IP whitelist: 83.222.9.37
#
# 5. Для настройки Google Sheets API:
#    - Следуйте инструкции в GOOGLE_SHEETS_SETUP.md
#    - Скачайте credentials.json
#    - Поместите файл в корень payment-server/
#    - Добавьте только ОДИН столбец X с заголовком "payment_status"
#
# 6. Методы оплаты CodeePay:
#    - 'sbp' - Система быстрых платежей (рекомендуется)
#    - 'card' - Карточная оплата
#
# 7. Важные замечания:
#    - CodeePay отправляет webhook только с IP 83.222.9.37
#    - Сервер должен отвечать 200 OK на webhook
#    - В Google Sheets нужен только столбец X для статуса оплаты
#    - Все остальные данные (команда, игроки и т.д.) уже есть из формы Tilda
#
